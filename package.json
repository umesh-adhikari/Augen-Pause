{
  "name": "augenpause",
  "productName": "AugenPause",
  "version": "1.0.0",
  "description": "Moderne Augenpausen- und Trink-Erinnerung für Windows, macOS und Linux",
  "main": "src/main/main.js",
  "author": "AugenPause",
  "license": "MIT",
  "desktopName": "augenpause.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.js\"",
    "icons": "node scripts/build-icons.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --win --mac --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  }
}
